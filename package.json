  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
